new file mode 100644
index 0000000..58709b7
--- /dev/null
+++ b/src/services/api/cacheDiagnostics.ts
@@ -0,0 +1,77 @@
+import { create } from 'zustand'
+import type { CreateMessageRequest, MessageUsage } from './types.js'
+
+export type RequestKind = 'chat' | 'memory-summary' | 'auxiliary'
+export type RequestTag = { kind: RequestKind; scope?: string; label?: string }
+export type CacheUsage = { prompt_tokens: number; prompt_cache_hit_tokens: number; prompt_cache_miss_tokens: number }
+export type PrefixDiff = { previousCount: number; currentCount: number; commonMessages: number; systemChanged: boolean; optionsChanged: string[]; firstChange: string; previousRole?: string; currentRole?: string }
+export type CacheRecord = { id: string; at: number; kind: RequestKind; scope?: string; label?: string; model: string; status: 'complete' | 'incomplete' | 'failed'; usage?: CacheUsage; diff?: PrefixDiff; compared: boolean }
+type State = { enabled: boolean; records: CacheRecord[] }
+const KEY = 'white:cache-diagnostics:v1'
+const read = (): State => {
+  try { const value = JSON.parse(localStorage.getItem(KEY) ?? 'null'); if (value && typeof value.enabled === 'boolean' && Array.isArray(value.records)) return { enabled: value.enabled, records: value.records.slice(0,120) } } catch { /* diagnostics never block chat */ }
+  return { enabled: true, records: [] }
+}
+export const useCacheDiagnostics = create<State>(() => read())
+const save = (state: State) => { useCacheDiagnostics.setState(state); try { localStorage.setItem(KEY, JSON.stringify(state)) } catch { /* in-memory results still available */ } }
+type Signature = { system: string; messages: { hash: string; role: string }[]; options: Record<string,string> }
+// Only hashes are kept, in RAM; never save or log API keys or conversation text.
+const prior = new Map<string, Signature>()
+let epoch = 0
+let sequence = 0
+export const setCacheDiagnostics = (enabled: boolean) => { epoch++; prior.clear(); save({ ...useCacheDiagnostics.getState(), enabled }) }
+export const clearCacheDiagnostics = () => { epoch++; prior.clear(); save({ ...useCacheDiagnostics.getState(), records: [] }) }
+const digest = async (text: string) => {
+  const bytes = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text))
+  return Array.from(new Uint8Array(bytes), n => n.toString(16).padStart(2,'0')).join('')
+}
+export const requestSignature = async (body: CreateMessageRequest): Promise<Signature> => {
+  const { system, messages, ...options } = body
+  const [systemHash, messageHashes] = await Promise.all([digest(JSON.stringify(system)), Promise.all(messages.map(async m => ({ role: m.role, hash: await digest(JSON.stringify(m)) })))])
+  const optionHashes = await Promise.all(Object.entries(options).map(async ([k,v]) => [k, await digest(JSON.stringify(v))] as const))
+  return { system: systemHash, messages: messageHashes, options: Object.fromEntries(optionHashes) }
+}
+export const compareSignatures = (a: Signature, b: Signature): PrefixDiff => {
+  let common = 0
+  while (common < Math.min(a.messages.length, b.messages.length) && a.messages[common]!.hash === b.messages[common]!.hash) common++
+  const systemChanged = a.system !== b.system
+  const optionsChanged = [...new Set([...Object.keys(a.options), ...Object.keys(b.options)])].filter(k => a.options[k] !== b.options[k])
+  const firstChange = systemChanged ? 'system（开头系统提示词）' : common === a.messages.length && common === b.messages.length ? '消息完全相同' : common === a.messages.length ? `第 ${common+1} 条（末尾追加，原消息全部一致）` : common === b.messages.length ? `第 ${common+1} 条（当前请求不再包含此消息）` : `第 ${common+1} 条消息`
+  return { previousCount: a.messages.length, currentCount: b.messages.length, commonMessages: common, systemChanged, optionsChanged, firstChange, previousRole: a.messages[common]?.role, currentRole: b.messages[common]?.role }
+}
+export const normalizeCacheUsage = (usage?: MessageUsage): CacheUsage | undefined => {
+  if (!usage) return undefined
+  const hit = usage.cache_read_input_tokens, miss = usage.input_tokens + (usage.cache_creation_input_tokens ?? 0)
+  if (!Number.isFinite(hit) || !Number.isFinite(miss) || hit < 0 || miss < 0) return undefined
+  return { prompt_tokens: hit+miss, prompt_cache_hit_tokens: hit, prompt_cache_miss_tokens: miss }
+}
+export const cacheTotals = (records: CacheRecord[], kind: RequestKind) => {
+  const rows = records.filter(r => r.kind === kind && r.usage)
+  const total = rows.reduce((n,r)=>n+r.usage!.prompt_tokens,0), hit = rows.reduce((n,r)=>n+r.usage!.prompt_cache_hit_tokens,0)
+  return { count: rows.length, total, hit, miss: total-hit, rate: total ? hit/total*100 : null }
+}
+export const beginCacheRequest = async (body: CreateMessageRequest, tag: RequestTag) => {
+  const at = Date.now(), id = `${at}-${++sequence}`, generation = epoch
+  let diff: PrefixDiff | undefined
+  const enabled = useCacheDiagnostics.getState().enabled
+  if (enabled) {
+    try {
+      const key = JSON.stringify([tag.kind, tag.scope ?? tag.label ?? 'default'])
+      const current = await requestSignature(body)
+      if (generation === epoch) {
+        const previous = prior.get(key)
+        if (previous) diff = compareSignatures(previous,current)
+        prior.delete(key); prior.set(key,current)
+        while (prior.size > 8) prior.delete(prior.keys().next().value!)
+      }
+    } catch { /* WebCrypto unavailable: usage logging still works */ }
+  }
+  return (status: CacheRecord['status'], usage?: MessageUsage) => {
+    try {
+      if (generation !== epoch) return
+      const row: CacheRecord = { id, at, kind: tag.kind, scope: tag.scope, label: tag.label, model: body.model, status, usage: normalizeCacheUsage(usage), diff, compared: !!diff }
+      const state = useCacheDiagnostics.getState()
+      save({ ...state, records: [row, ...state.records].slice(0,120) })
+    } catch { /* diagnostics must never break chat */ }
+  }
+}
