+import { validateCompaction } from './compaction.js'
+import type { Compaction, CompactionVersion, Message, Session } from './types.js'
+
+// Each version contains only compression metadata, never a duplicate of the original conversation.
+export const MAX_COMPACTION_VERSIONS = 5
+export const captureCompactionVersion = (session: Session, label: string): CompactionVersion => ({
+  createdAt: Date.now(), label, auto: session.compaction, manual: session.manualCompaction,
+})
+export const appendCompactionVersion = (session: Session, label: string) => [
+  ...(session.compactionVersions ?? []), captureCompactionVersion(session,label),
+].slice(-MAX_COMPACTION_VERSIONS)
+
+const fromBlocks = (blocks: NonNullable<Compaction['blocks']>): Compaction | undefined => blocks.length ? {
+  blocks, text: blocks.map(b=>b.text).join('\n\n'), msgIds: blocks.flatMap(b=>b.msgIds),
+  coveredTokens: blocks.reduce((n,b)=>n+b.coveredTokens,0), createdAt: Math.max(...blocks.map(b=>b.createdAt)),
+} : undefined
+
+/** Restore only compression metadata; validate against the current branch, exclusions and protected rounds.
+ * Never revert messages, memory library, favorites, or user edits. Do not requeue an uncompleted summary. */
+export const applyCompactionVersion = (session: Session, version: CompactionVersion, history: Message[]): Session => {
+  const auto = validateCompaction(version.auto,history,session)
+  const covered = new Set(auto?.msgIds ?? [])
+  const manual = fromBlocks((validateCompaction(version.manual,history,session)?.blocks ?? [])
+    .filter(b=>!b.msgIds.some(id=>covered.has(id))))
+  const ids=manual?.msgIds ?? []
+  return {...session, compaction:auto, manualCompaction:manual, contextCompress:ids.length,
+    safeManualRequested:ids.length>0, manualTargetIds:ids,
+    manualTargetReplyIds:manual?.blocks?.flatMap(b=>b.replyIds) ?? [], compactionPaused:true}
+}
+export const rollbackCompactionVersion = (session: Session, index: number, history: Message[]): Session => {
+  const versions=session.compactionVersions ?? []
+  if(!Number.isInteger(index)||index<0||index>=versions.length)throw new Error('压缩版本不存在')
+  return {...applyCompactionVersion(session,versions[index]!,history),compactionVersions:versions.slice(0,index)}
+}
+export const restoreAllCompaction = (session: Session, history: Message[]): Session => ({
+  ...applyCompactionVersion(session,{createdAt:Date.now(),label:'恢复全部原文'},history),
+  compactionVersions:appendCompactionVersion(session,'恢复全部原文前'),
+})
+/** Selectively restore a whole block, because removing part of its summary would leave unverified claims. */
+export const restoreCompactionBlock = (session: Session, kind: 'auto'|'manual', index: number, history: Message[]): Session => {
+  const version=captureCompactionVersion(session,'恢复单个摘要块前')
+  const source=version[kind]
+  if(!source?.blocks?.[index])throw new Error('摘要块不存在')
+  version[kind]=fromBlocks(source.blocks.filter((_,i)=>i!==index))
+  return {...applyCompactionVersion(session,version,history),compactionVersions:appendCompactionVersion(session,'恢复单个摘要块前')}
+}
+/** Rollback metadata only on a persistence failure; never overwrite current messages. */
+export const compressionFields = (session:Session) => ({
+  compaction:session.compaction, manualCompaction:session.manualCompaction, contextCompress:session.contextCompress,
+  safeManualRequested:session.safeManualRequested, manualTargetIds:session.manualTargetIds,
+  manualTargetReplyIds:session.manualTargetReplyIds, compactionPaused:session.compactionPaused,
+  compactionVersions:session.compactionVersions, compactionProfile:session.compactionProfile,
+})
