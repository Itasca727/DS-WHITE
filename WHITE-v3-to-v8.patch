+
+const names: Record<RequestKind,string> = { chat: '普通聊天', 'memory-summary': '记忆总结', auxiliary: '其他辅助 API' }
+export const CacheDiagnosticsDialog = ({ sessionId, onClose }: { sessionId: string; onClose: () => void }) => {
+  const { enabled, records } = useCacheDiagnostics()
+  const [scope,setScope] = useState('session'), [notice,setNotice] = useState('')
