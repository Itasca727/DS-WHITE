+// Separate password-encrypted portable backup. Never embed the API key in backups.
+export type SecureBackup={version:1;format:'white-encrypted-backup';kind:'memory'|'favorites'|'chat';salt:string;iv:string;cipher:string}
+export const encryptBackup=async(data:string,password:string,kind:SecureBackup['kind']):Promise<string>=>{
