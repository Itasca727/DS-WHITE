+const decode=(b:ArrayBuffer)=>new TextDecoder('utf-8',{fatal:true}).decode(b)
+const b64=(b:Uint8Array)=>{let s='';for(let i=0;i<b.length;i+=8192)s+=String.fromCharCode(...b.subarray(i,i+8192));return btoa(s)}
