+import { createVault, unlockVault, vaultEnabled, vaultStatus, subscribeVault, retryVault, flushVault } from './privacyVault.js'
+/** Before any store module is imported, display a real password field and unlock locally. */
+export const startPrivacyGate=async()=>{
+  const url=new URL(location.href),setup=url.searchParams.get('white-vault')==='setup'
+  if(!vaultEnabled()&&!setup)return
+  const root=document.getElementById('root')!
+  const form=document.createElement('form');form.style.cssText='max-width:420px;margin:12vh auto;padding:24px;display:grid;gap:14px;font:16px system-ui;color:inherit'
+  const heading=document.createElement('h2'),description=document.createElement('p'),password=document.createElement('input'),confirm=document.createElement('input'),button=document.createElement('button'),status=document.createElement('p'),cancel=document.createElement('button')
+  const exists=vaultEnabled();heading.textContent=exists?'WHITE 本地记忆保险库':'启用 WHITE 本地加密'
+  description.textContent=exists?'输入本地密码解锁记忆库、待审核任务、收藏和 API Key。密码不上传。':'加密记忆库、任务草稿、收藏和 API Key；原聊天 IndexedDB、历史快照和已有备份不在加密范围。先备份，关闭其他 WHITE 标签页。忘记密码无法恢复。'
+  password.type='password';password.placeholder='本地密码';password.required=true;password.autocomplete=exists?'current-password':'new-password'
+  confirm.type='password';confirm.placeholder='再次输入新密码';confirm.autocomplete='new-password';confirm.required=!exists
+  button.textContent=exists?'解锁':'确认加密';button.type='submit';cancel.type='button';cancel.textContent='取消并返回';status.setAttribute('role','alert')
+  form.append(heading,description,password);if(!exists)form.append(confirm);form.append(button,status);if(!exists)form.append(cancel);root.replaceChildren(form)
+  await new Promise<void>(resolve=>{
+    const finish=()=>{url.searchParams.delete('white-vault');history.replaceState(null,'',url);root.replaceChildren();resolve()}
+    cancel.onclick=()=>{if(!vaultEnabled())finish()}
+    form.onsubmit=async e=>{e.preventDefault();button.disabled=true;cancel.disabled=true;status.textContent='正在本机验证…';try{if(exists)await unlockVault(password.value);else{if(password.value!==confirm.value)throw Error('两次密码不一致');await createVault(password.value)}password.value='';confirm.value='';finish()}catch(error){status.textContent=error instanceof Error?error.message:'无法解锁或保存，请检查密码与存储';button.disabled=false;cancel.disabled=false}}
+  })
+  if(!vaultEnabled())return
+  const banner=document.createElement('div');banner.style.cssText='position:fixed;bottom:0;left:0;right:0;z-index:99999;padding:8px;background:#7c2d12;color:#fff;text-align:center;display:none;font:13px system-ui'
+  const text=document.createElement('span'),retry=document.createElement('button');retry.textContent='重试保存';retry.onclick=()=>{void retryVault().catch(()=>{})};banner.append(text,retry);document.body.append(banner)
+  const update=()=>{const s=vaultStatus();banner.style.display=s.failed||s.pending?'block':'none';text.textContent=s.failed?'加密保存失败，请先重试或备份，不要关闭页面。':'正在安全保存，请勿关闭页面。';retry.style.display=s.failed?'inline':'none'};subscribeVault(update);update()
+  window.addEventListener('beforeunload',e=>{const s=vaultStatus();if(s.pending||s.failed){e.preventDefault();e.returnValue=''}})
+  void flushVault().catch(()=>{})
+}
