+import { useRef, useState } from 'react'
+import { createPortal } from 'react-dom'
+import { useChatStore } from '../../services/chat/store.js'
+import { useMemoryTasks } from '../../services/chat/memoryTasks.js'
+import { exportMemoryLibrary, importMemoryLibrary } from '../../services/memoryLibrary.js'
+import { exportFavorites, importFavorites } from '../../services/favorites.js'
+import { exportHistory } from '../../services/chat/backup.js'
+import { vaultEnabled, lockVault, encryptBackup, decryptBackup, encodeBackupBlob, decodeBackupBlob, readSecurityLog, securityLog, type SecureBackup } from '../../services/privacyVault.js'
+import { saveFile } from '../../utils/saveFile.js'
+import styles from '../session/MemoryLibraryDialog.module.css'
+type Kind=SecureBackup['kind']
+export const PrivacyPanel=({onChatImport}:{onChatImport:(file:File)=>void})=>{
+  const [notice,setNotice]=useState(''),[busy,setBusy]=useState(false),[kind,setKind]=useState<Kind>('memory'),[request,setRequest]=useState<{kind:Kind;file?:File}>(),[password,setPassword]=useState(''),[confirmation,setConfirmation]=useState('')
+  const input=useRef<HTMLInputElement>(null)
+  const streaming=useChatStore(s=>Object.values(s.streaming).some(Boolean)||s.importingHistory)
+  const summarizing=useMemoryTasks(s=>Object.values(s.running).some(Boolean))
+  const reset=()=>{setRequest(undefined);setPassword('');setConfirmation('')}
+  const run=async()=>{
+    if(!request)return
+    const r=request,p=password
+    if(!r.file&&(p.length<10||p!==confirmation)){setNotice('备份密码至少10字符且两次输入须一致');return}
+    reset();setBusy(true);setNotice('')
+    try{
+      if(r.file){
+        const data=await decryptBackup(await r.file.text(),p,r.kind)
+        if(r.kind==='chat'){onChatImport(new File([decodeBackupBlob(data)],'white-decrypted-chat.zip',{type:'application/zip'}));setNotice('已解密；仍需在原聊天导入确认框中确认替换。')}
+        else if(r.kind==='memory'){const n=importMemoryLibrary(data);setNotice(`已合并 ${n} 条记忆（默认停用）`)}
+        else{importFavorites(data);setNotice('收藏已合并')}
+        securityLog('导入加密备份 · '+r.kind)
+      }else{
+        const data=r.kind==='memory'?exportMemoryLibrary():r.kind==='favorites'?exportFavorites():await encodeBackupBlob((await exportHistory()).blob)
+        const encrypted=await encryptBackup(data,p,r.kind)
+        const saved=await saveFile(new File([encrypted],`white-${r.kind}.whiteenc`,{type:'application/json'}))
+        if(saved){securityLog('导出加密备份 · '+r.kind);setNotice('已生成加密备份')}else setNotice('已取消保存')
+      }
+    }catch(e){setNotice(e instanceof Error?e.message:'加密/解密失败，原数据不变')}
+    finally{setBusy(false)}
+  }
+  const changeVault=()=>{
+    if(streaming||summarizing||busy)return
+    if(vaultEnabled()){void lockVault().catch(e=>setNotice(String(e)));return}
+    if(!window.confirm('启用前请先备份并关闭其他 WHITE 标签页。忘记密码不能恢复。仅加密记忆库、任务草稿、收藏及 API Key，原聊天/历史快照不在加密范围。继续？'))return
+    const url=new URL(location.href);url.searchParams.set('white-vault','setup');location.assign(url)
+  }
+  return <div className={styles.section} style={{padding:12}}>
+    <strong>V9 · 本地安全与加密备份</strong>
+    <small>{vaultEnabled()?'已启用本地加密；刷新后需密码解锁。':'尚未启用本地加密（可选）'}。AES-256-GCM + PBKDF2-SHA256。密码只在本机使用。原聊天 IndexedDB、历史记忆快照、已有自动备份不在静态加密范围；解锁时的恶意脚本仍可读取数据。</small>
+    <div className={styles.actions}><button disabled={busy||streaming||summarizing} onClick={changeVault}>{vaultEnabled()?'锁定并重新打开':'启用本地记忆保险库'}</button></div>
+    <label>加密备份类型 <select value={kind} disabled={busy} onChange={e=>setKind(e.target.value as Kind)}><option value="memory">记忆库 JSON</option><option value="favorites">收藏夹 JSON</option><option value="chat">原版聊天 ZIP</option></select></label>
+    <small>手动备份另设密码，不含 API Key；聊天 ZIP 沿用原导出范围。大 ZIP 加密需要额外内存，旧手机可能失败。原有自动备份仍为原格式。</small>
+    <div className={styles.actions}><button disabled={busy||streaming||summarizing} onClick={()=>setRequest({kind})}>导出加密备份</button><button disabled={busy||streaming||summarizing} onClick={()=>input.current?.click()}>导入加密备份</button><input ref={input} hidden type="file" accept=".whiteenc,application/json" onChange={e=>{const f=e.target.files?.[0];e.target.value='';if(f)setRequest({kind,file:f})}}/></div>
+    {notice&&<small role="status">{notice}</small>}
+    {request&&createPortal(<div style={{position:'fixed',inset:0,zIndex:100000,background:'#0009',display:'grid',placeItems:'center',padding:16}}><form style={{background:'var(--bg-color, #fff)',color:'#222',padding:20,borderRadius:12,maxWidth:400,width:'100%',display:'grid',gap:12}} onSubmit={e=>{e.preventDefault();void run()}}><strong>{request.file?'输入备份解密密码':'设置加密备份密码'}</strong><input aria-label="备份密码" type="password" required autoComplete={request.file?'current-password':'new-password'} value={password} onChange={e=>setPassword(e.target.value)}/>{!request.file&&<input aria-label="确认密码" type="password" required autoComplete="new-password" value={confirmation} onChange={e=>setConfirmation(e.target.value)}/>}<button type="submit">确认</button><button type="button" onClick={reset}>取消</button></form></div>,document.body)}
+    <details><summary>本地安全操作日志（最近100条）</summary>{readSecurityLog().map((r,i)=><small key={i} style={{display:'block'}}>{new Date(r.at).toLocaleString()} · {r.event}</small>)}<small>仅记录本应用操作，不是入侵检测或服务器访问日志。</small></details>
+  </div>
+}
