+export const subscribeVault=(listener:()=>void)=>{listeners.add(listener);return ()=>{listeners.delete(listener)}}
+export const vaultEnabled=()=>{try{return localStorage.getItem(VAULT)!==null}catch{return false}}
+export const securityLog=(event:string)=>{
+  try{const rows=JSON.parse(localStorage.getItem(LOG)??'[]');localStorage.setItem(LOG,JSON.stringify([{at:Date.now(),event},...(Array.isArray(rows)?rows:[])].slice(0,100)))}catch{/* never log contents or block chat */}
+}
+export const readSecurityLog=():{at:number;event:string}[]=>{try{const rows=JSON.parse(localStorage.getItem(LOG)??'[]');return Array.isArray(rows)?rows:[]}catch{return []}}
+const exclusive=async()=>{
+  if(releaseLock)return
+  if(!navigator.locks)throw Error('此浏览器缺少 Web Locks，无法安全启用多标签页互斥保护')
